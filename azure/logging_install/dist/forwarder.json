{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.40.2.10011",
      "templateHash": "1740602636653115602"
    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "defaultValue": "datadog-log-forwarder-env",
      "minLength": 2,
      "maxLength": 60,
      "metadata": {
        "description": "Name of the Container App Managed Environment for the Forwarder"
      }
    },
    "jobName": {
      "type": "string",
      "defaultValue": "datadog-log-forwarder",
      "minLength": 1,
      "maxLength": 260,
      "metadata": {
        "description": "Name of the Forwarder Container App Job"
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "[format('ddlog{0}', uniqueString(resourceGroup().id))]",
      "minLength": 3,
      "maxLength": 24,
      "metadata": {
        "description": "Name of the Log Storage Account"
      }
    },
    "storageAccountSku": {
      "type": "string",
      "defaultValue": "Standard_LRS",
      "allowedValues": [
        "Premium_LRS",
        "Premium_ZRS",
        "Standard_GRS",
        "Standard_GZRS",
        "Standard_LRS",
        "Standard_RAGRS",
        "Standard_RAGZRS",
        "Standard_ZRS"
      ],
      "metadata": {
        "description": "The SKU of the storage account"
      }
    },
    "storageAccountRetentionDays": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "metadata": {
        "description": "The number of days to retain logs (and internal metrics) in the storage account"
      }
    },
    "datadogApiKey": {
      "type": "securestring",
      "minLength": 32,
      "maxLength": 32,
      "metadata": {
        "description": "Datadog API Key"
      }
    },
    "datadogSite": {
      "type": "string",
      "defaultValue": "datadoghq.com",
      "allowedValues": [
        "datadoghq.com",
        "datadoghq.eu",
        "ap1.datadoghq.com",
        "ap2.datadoghq.com",
        "uk1.datadoghq.com",
        "us3.datadoghq.com",
        "us5.datadoghq.com",
        "ddog-gov.com"
      ]
    },
    "enableVnetIntegration": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "Enable VNet integration: deploys the Container App Environment into a VNet and disables public access on the storage account (using a private endpoint instead)."
      }
    },
    "createNewVnet": {
      "type": "bool",
      "defaultValue": true,
      "metadata": {
        "description": "Create a new VNet and subnets automatically. Set to false to use existing subnets. Only applies when enableVnetIntegration is true."
      }
    },
    "vnetName": {
      "type": "string",
      "defaultValue": "datadog-log-forwarder-vnet",
      "metadata": {
        "description": "Name for the new VNet. Only used when createNewVnet is true."
      }
    },
    "vnetAddressPrefix": {
      "type": "string",
      "defaultValue": "10.0.0.0/16",
      "metadata": {
        "description": "Address space for the new VNet. Only used when createNewVnet is true."
      }
    },
    "acaSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.0.0.0/23",
      "metadata": {
        "description": "Address prefix for the Container App Environment subnet (minimum /23). Only used when createNewVnet is true."
      }
    },
    "peSubnetPrefix": {
      "type": "string",
      "defaultValue": "10.0.2.0/28",
      "metadata": {
        "description": "Address prefix for the storage private endpoint subnet (minimum /28). Only used when createNewVnet is true."
      }
    },
    "existingVnetId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource ID of an existing VNet. Required when enableVnetIntegration is true and createNewVnet is false."
      }
    },
    "existingInfrastructureSubnetId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource ID of an existing subnet for the Container App Environment. Must be delegated to Microsoft.App/environments and at least /23. Required when enableVnetIntegration is true and createNewVnet is false."
      }
    },
    "existingStoragePrivateEndpointSubnetId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Resource ID of an existing subnet for the storage private endpoint. Leave empty to reuse existingInfrastructureSubnetId. Only used when createNewVnet is false."
      }
    }
  },
  "variables": {
    "enableVnet": "[parameters('enableVnetIntegration')]",
    "resolvedVnetId": "[if(parameters('enableVnetIntegration'), if(parameters('createNewVnet'), resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName')), parameters('existingVnetId')), '')]",
    "resolvedAcaSubnetId": "[if(parameters('enableVnetIntegration'), if(parameters('createNewVnet'), resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), 'aca-subnet'), parameters('existingInfrastructureSubnetId')), '')]",
    "resolvedPeSubnetId": "[if(parameters('enableVnetIntegration'), if(parameters('createNewVnet'), resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), 'pe-subnet'), if(not(equals(parameters('existingStoragePrivateEndpointSubnetId'), '')), parameters('existingStoragePrivateEndpointSubnetId'), parameters('existingInfrastructureSubnetId'))), '')]"
  },
  "resources": [
    {
      "condition": "[and(parameters('enableVnetIntegration'), parameters('createNewVnet'))]",
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2023-11-01",
      "name": "[parameters('vnetName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('vnetAddressPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "aca-subnet",
            "properties": {
              "addressPrefix": "[parameters('acaSubnetPrefix')]",
              "delegations": [
                {
                  "name": "Microsoft.App-environments",
                  "properties": {
                    "serviceName": "Microsoft.App/environments"
                  }
                }
              ]
            }
          },
          {
            "name": "pe-subnet",
            "properties": {
              "addressPrefix": "[parameters('peSubnetPrefix')]"
            }
          }
        ]
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2023-05-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[resourceGroup().location]",
      "sku": {
        "name": "[parameters('storageAccountSku')]"
      },
      "kind": "StorageV2",
      "properties": {
        "minimumTlsVersion": "TLS1_2",
        "supportsHttpsTrafficOnly": true,
        "allowBlobPublicAccess": false,
        "publicNetworkAccess": "[if(variables('enableVnet'), 'Disabled', null())]",
        "networkAcls": "[if(variables('enableVnet'), createObject('defaultAction', 'Deny', 'bypass', 'AzureServices'), null())]"
      }
    },
    {
      "type": "Microsoft.Storage/storageAccounts/managementPolicies",
      "apiVersion": "2023-05-01",
      "name": "[format('{0}/{1}', parameters('storageAccountName'), 'default')]",
      "properties": {
        "policy": {
          "rules": [
            {
              "enabled": true,
              "name": "Delete Old Blobs",
              "type": "Lifecycle",
              "definition": {
                "actions": {
                  "baseBlob": {
                    "delete": {
                      "daysAfterModificationGreaterThan": "[parameters('storageAccountRetentionDays')]"
                    }
                  },
                  "snapshot": {
                    "delete": {
                      "daysAfterCreationGreaterThan": "[parameters('storageAccountRetentionDays')]"
                    }
                  }
                },
                "filters": {
                  "blobTypes": [
                    "blockBlob",
                    "appendBlob"
                  ]
                }
              }
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[parameters('environmentName')]",
      "location": "[resourceGroup().location]",
      "properties": "[if(variables('enableVnet'), createObject('vnetConfiguration', createObject('infrastructureSubnetId', variables('resolvedAcaSubnetId'))), createObject())]"
    },
    {
      "type": "Microsoft.App/jobs",
      "apiVersion": "2023-05-01",
      "name": "[parameters('jobName')]",
      "location": "[resourceGroup().location]",
      "properties": {
        "environmentId": "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "configuration": {
          "triggerType": "Schedule",
          "replicaTimeout": 1800,
          "replicaRetryLimit": 1,
          "scheduleTriggerConfig": {
            "cronExpression": "* * * * *",
            "parallelism": 1,
            "replicaCompletionCount": 1
          },
          "secrets": [
            {
              "name": "storage-connection-string",
              "value": "[format('DefaultEndpointsProtocol=https;AccountName={0};EndpointSuffix={1};AccountKey={2}', parameters('storageAccountName'), environment().suffixes.storage, listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2023-05-01').keys[0].value)]"
            },
            {
              "name": "dd-api-key",
              "value": "[parameters('datadogApiKey')]"
            }
          ]
        },
        "template": {
          "containers": [
            {
              "name": "datadog-forwarder",
              "image": "datadoghq.azurecr.io/forwarder:latest",
              "resources": {
                "cpu": 2,
                "memory": "4Gi"
              },
              "env": [
                {
                  "name": "AzureWebJobsStorage",
                  "secretRef": "storage-connection-string"
                },
                {
                  "name": "DD_API_KEY",
                  "secretRef": "dd-api-key"
                },
                {
                  "name": "DD_SITE",
                  "value": "[parameters('datadogSite')]"
                },
                {
                  "name": "CONTROL_PLANE_ID",
                  "value": "none"
                },
                {
                  "name": "CONFIG_ID",
                  "value": "[resourceId('Microsoft.App/jobs', parameters('jobName'))]"
                }
              ]
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', parameters('environmentName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ]
    },
    {
      "condition": "[variables('enableVnet')]",
      "type": "Microsoft.Network/privateEndpoints",
      "apiVersion": "2023-11-01",
      "name": "[format('{0}-blob-pe', parameters('storageAccountName'))]",
      "location": "[resourceGroup().location]",
      "properties": {
        "subnet": {
          "id": "[variables('resolvedPeSubnetId')]"
        },
        "privateLinkServiceConnections": [
          {
            "name": "[format('{0}-blob-connection', parameters('storageAccountName'))]",
            "properties": {
              "privateLinkServiceId": "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]",
              "groupIds": [
                "blob"
              ]
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ]
    },
    {
      "condition": "[variables('enableVnet')]",
      "type": "Microsoft.Network/privateDnsZones",
      "apiVersion": "2020-06-01",
      "name": "[format('privatelink.blob.{0}', environment().suffixes.storage)]",
      "location": "global"
    },
    {
      "condition": "[variables('enableVnet')]",
      "type": "Microsoft.Network/privateDnsZones/virtualNetworkLinks",
      "apiVersion": "2020-06-01",
      "name": "[format('{0}/{1}', format('privatelink.blob.{0}', environment().suffixes.storage), 'blob-dns-zone-vnet-link')]",
      "location": "global",
      "properties": {
        "virtualNetwork": {
          "id": "[variables('resolvedVnetId')]"
        },
        "registrationEnabled": false
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', format('privatelink.blob.{0}', environment().suffixes.storage))]"
      ]
    },
    {
      "condition": "[variables('enableVnet')]",
      "type": "Microsoft.Network/privateEndpoints/privateDnsZoneGroups",
      "apiVersion": "2023-11-01",
      "name": "[format('{0}/{1}', format('{0}-blob-pe', parameters('storageAccountName')), 'blob-dns-zone-group')]",
      "properties": {
        "privateDnsZoneConfigs": [
          {
            "name": "config",
            "properties": {
              "privateDnsZoneId": "[resourceId('Microsoft.Network/privateDnsZones', format('privatelink.blob.{0}', environment().suffixes.storage))]"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/privateDnsZones', format('privatelink.blob.{0}', environment().suffixes.storage))]",
        "[resourceId('Microsoft.Network/privateEndpoints', format('{0}-blob-pe', parameters('storageAccountName')))]"
      ]
    }
  ]
}